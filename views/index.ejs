<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
     <title>Create Account</title>
</head>
<body>
  
    <h2 style="color: white; margin: 10px;">Create Account</h2>
    <div class="container">
        <form action="/create" method="post">
            <input class="inputs"  type="text" placeholder="NAME"  name="name" >
            <input class="inputs"  type="text" placeholder="USERNAME"  name="username" >
            <input class="inputs" type="email" placeholder="EMAIL" name="email" >
            <input class="inputs" type="password" placeholder="PASSWORD" name="password" >
            <input class="btn" type="submit" value="Create Account ">
        </form>
    </div>
</body>
</html>